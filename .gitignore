# macOS
.DS_Store
.AppleDouble
.LSOverride

.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
workspaces/
.sibyl/
pytest-of-*/
pytest-current
tools/*/.tmp-state/
.claude/*
!.claude/agents/
!.claude/agents/*.md
# The real tier definitions live in agents-<provider>/; `.claude/agents` is only
# a symlink to whichever is active. Without these negations the files that
# decide which model EVERY skill runs on were silently untracked, which is how
# the Anthropic tiers drifted to Opus-for-everything unnoticed.
!.claude/agents-anthropic/
!.claude/agents-anthropic/*.md
!.claude/agents-deepseek/
!.claude/agents-deepseek/*.md
!.claude/skills/
!.claude/skills/**/SKILL.md
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/*.sh
.claude/settings.local.json

# Legacy experiment artifacts (pre-v5)
exp/
logs/
writing/

# Root-level config (local overrides, not committed)
/config.yaml

# Sensitive / credentials
user_token_cache.json
*.secret
.env
.env.*

# Playwright MCP logs
.playwright-mcp/
.playwright-cli/

# Misc temp files
.history/
.serena/
cli_pause
暂停
进入
连续失败
重试一次
.aider*
